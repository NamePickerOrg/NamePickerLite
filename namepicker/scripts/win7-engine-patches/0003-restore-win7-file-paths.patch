+// Adds the `\\?\` extended-length prefix to an already absolute path. UNC
+// paths use the `\\?\UNC\` form.
+//
+// This is a Windows 7 compatible replacement for
+// PathAllocCanonicalize(..., PATHCCH_ENSURE_IS_EXTENDED_LENGTH_PATH, ...),
+// which is only available on Windows 8 and later.
+static std::unique_ptr<wchar_t[]> ToExtendedLengthPath(
+    std::unique_ptr<wchar_t[]> path) {
+  if (path.get() == nullptr) {
+    return path;
+  }
+  if (IsLongPathPrefixed(path) || IsDeviceNamespacePrefixed(path)) {
+    return path;
+  }
+  const bool is_unc = path[0] == L'\\' && path[1] == L'\\';
+  const wchar_t* const prefix = is_unc ? L"\\\\?\\UNC\\" : L"\\\\?\\";
+  const wchar_t* const remainder = is_unc ? path.get() + 2 : path.get();
+  const size_t result_length = wcslen(prefix) + wcslen(remainder) + 1;
+  auto result = std::make_unique<wchar_t[]>(result_length);
+  wcscpy_s(result.get(), result_length, prefix);
+  wcscat_s(result.get(), result_length, remainder);
+  return result;
+}
